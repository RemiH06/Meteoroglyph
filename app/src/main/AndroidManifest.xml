            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.IconWind"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_weather_wind"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.IconFog"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_weather_fog"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.IconCold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_weather_cold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.IconHot"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_weather_hot"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
    </application>

</manifest>